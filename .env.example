# ============================================================
#  .env.example —— LangGraph 科研 Agent 环境变量模板
#  复制为 .env 并填入你的值；所有 key 均为占位符，请勿直接使用。
# ============================================================

# ── 模型模式与主模型（single：所有节点用同一模型）──
#   multi 模式按 ROUTER_/AGENT_/EXTRACT_/WRITER_/JUDGE_/SAFETY_MODEL 各角色分别路由
MODEL_MODE=single
SINGLE_MODEL=deepseek-chat
SINGLE_BASE=https://api.deepseek.com
SINGLE_KEY=
DEEPSEEK_API_KEY=

# ── 可选：OpenAI 兼容端点 ──
OPENAI_API_BASE=
OPENAI_API_KEY=
MAIN_MODEL=

# ── multi 模式角色模型（可选）──
ROUTER_MODEL=
AGENT_MODEL=
EXTRACT_MODEL=
WRITER_MODEL=
JUDGE_MODEL=
SAFETY_MODEL=

# ── 可选：Qwen 评测模型（评审/返修环节）──
DASHSCOPE_API_KEY=
QWEN_EVAL_MODEL=
QWEN_EVAL_BASE=

# ── 论文检索（MCP 子进程）──
PAPER_SEARCH_PYTHON=python
GS_PROXY_URL=
MCP_PROXY=

# ── Web 搜索（tavily-mcp）──
TAVILY_API_KEY=

# ── 重排（Cross-Encoder）──
RERANK_API_BASE=
RERANK_API_KEY=
RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B

# ── Embedding（bge-m3）──
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=
EMBEDDING_MODEL=BAAI/bge-m3
EMBED_DIM=1024

# ── 代码执行沙箱 ──
#   LANGGRAPH_EXEC_BACKEND: local（默认，本地直跑）| docker
#   CONDA_PYTHON: local 后端运行训练脚本的解释器（需含 torch 等依赖）
LANGGRAPH_EXEC_BACKEND=local
CONDA_PYTHON=python
EXEC_WORKSPACE=
EXEC_TIMEOUT=300
EXEC_MAX_OUTPUT=20000

# ── Redis（多级缓存 L0/L1）──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_REDIS_DB=1
CACHE_TTL=86400
CACHE_ENABLED=1
